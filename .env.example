# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# Default PostgreSQL URL for Docker / Local Postgres:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/cognitor_db?schema=public"

# Admin Authentication
ADMIN_PASSWORD=adminpassword123
JWT_SECRET=super-secret-jwt-key-cognitor-2026

# Optional LLM API Key (for scripts/fill_llm.ts)
# Supports Anthropic Claude or Google Gemini API
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
