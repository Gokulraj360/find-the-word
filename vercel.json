{
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://cognitor-uwnx.onrender.com/api/$1"
    },
    {
      "source": "/healthz",
      "destination": "https://cognitor-uwnx.onrender.com/healthz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
